#!/bin/bash
# Prints what step 15 starts from as JSON: the git identity (prefilled from
# the owner form's full name when git has none), existing SSH public keys,
# and the default editor.
exec </dev/null

gecos=$(getent passwd "$USER" 2>/dev/null | cut -d: -f5 | cut -d, -f1)
git_name=$(git config --global user.name 2>/dev/null)
git_email=$(git config --global user.email 2>/dev/null)
# The editor Super + Shift + N really opens: omarchy-launch-editor falls back
# to nvim when the configured one isn't installed.
editor=$(omarchy default editor 2>/dev/null)
omarchy-cmd-present "${editor:-nvim}" >/dev/null 2>&1 || editor="nvim"

keys=$(find "$HOME/.ssh" -maxdepth 1 -name 'id_*.pub' 2>/dev/null | sort | jq -R . | jq -cs .)

jq -cn --arg name "${git_name:-$gecos}" --arg email "$git_email" \
  --argjson gitSet "$([[ -n $git_name && -n $git_email ]] && echo true || echo false)" \
  --argjson keys "${keys:-[]}" --arg editor "$editor" '$ARGS.named'
