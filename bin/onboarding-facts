#!/bin/bash
# Prints what the overlay needs to know about the machine, one per line:
#   1. `nmcli networking connectivity` (full, limited, portal, none, or empty)
#   2. `omarchy default browser`
#   3. the Wi-Fi network in use, or empty (wired, or offline)
#   4. where the bar is: top, bottom, left or right
#   5. the default coding agent's id, "none" when none is chosen, or empty
#      when this Omarchy has no `omarchy default agent`
#   6. that agent's name ("Claude"), or empty
#   7. what `omarchy-default-agent` is doing, if it is running: "installing"
#      for the terminal that installs an agent and then starts it (it lasts
#      as long as that terminal), "busy" while one is being set, else empty
exec </dev/null

nmcli networking connectivity 2>/dev/null || echo
omarchy default browser 2>/dev/null || echo
# Terse output escapes colons in names as "\:"; the active row starts "yes:".
nmcli -t -f active,ssid device wifi 2>/dev/null | sed -n 's/^yes://p' | sed 's/\\:/:/g' | head -n1
jq -r '.bar.position // "top"' "$HOME/.config/omarchy/shell.json" 2>/dev/null || echo top

if command -v omarchy-default-agent >/dev/null 2>&1; then
  agent=$(omarchy-default-agent 2>/dev/null) || agent=""
  echo "${agent:-none}"
  # The agent's own name, from the menu's English labels (onboarding's copy is
  # English only).
  [[ -n $agent ]] && jq -r --arg key "setup.default.agent.$agent" '.[$key].label // empty' \
    "${OMARCHY_PATH:-/usr/share/omarchy}/default/i18n/en/menu.json" 2>/dev/null || echo
else
  echo
  echo
fi
# Anchored, so only the script itself matches and not a shell or an editor
# that happens to name it: the presentation wrapper runs the install as
# `bash -c "omarchy-show-logo; <command>; ..."`, and the menu runs the script.
name=omarchy-default-agent
if pgrep -f "^bash -c omarchy-show-logo; $name --install " >/dev/null 2>&1; then
  echo installing
elif pgrep -f "^(/usr/bin/|/bin/)?bash [^ ]*$name " >/dev/null 2>&1; then
  echo busy
else
  echo
fi
