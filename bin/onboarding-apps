#!/bin/bash
# Prints the everyday-app bindings as JSON: [{label, keys, command, installs}],
# read from the live Hyprland config through omarchy-menu-keybindings, so the
# user's own rebinds show. `installs` is true when trying the app would
# install it first (Omarchy's install-on-first-use launchers).
exec </dev/null

APPS=("File manager" "Music" "Passwords" "Email" "Calendar" "Signal" "WhatsApp")
script=$(command -v omarchy-menu-keybindings) || { echo '[]'; exit 0; }

# The script has no flag for its records, so load its functions without
# running its menu and call the one that lists them.
records=$(bash -c 'source <(sed "/^if \[\[ \$1 == \"--print\"/,\$d" "$1") && output_binding_records' _ "$script" 2>/dev/null) || records=""

installs() {
  case $1 in
    *omarchy-launch-spotify*) [[ ! -x /usr/bin/spotify ]] ;;
    *omarchy-launch-1password*) ! omarchy-cmd-present 1password >/dev/null 2>&1 ;;
    *omarchy-launch-signal*) [[ ! -x /usr/bin/signal-desktop ]] ;;
    *) return 1 ;;
  esac
}

for app in "${APPS[@]}"; do
  line=$(awk -F '\t' -v app="$app" '{ split($1, p, " → "); if (p[2] == app && $2 == "exec") { print; exit } }' <<<"$records")
  [[ -n $line ]] || continue
  keys=$(cut -f1 <<<"$line" | sed -E 's/ +→.*//; s/ \+ / + /; s/^SUPER/Super/; s/ SHIFT/ + Shift/; s/ CTRL/ + Ctrl/; s/ ALT/ + Alt/; s/\+ ([A-Z])([A-Z]+)$/+ \1\L\2/; s/SLASH/\//I')
  command=$(cut -f3- <<<"$line")
  jq -cn --arg label "$app" --arg keys "$keys" --arg command "$command" \
    --argjson installs "$(installs "$command" && echo true || echo false)" '$ARGS.named'
done | jq -cs .
