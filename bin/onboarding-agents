#!/bin/bash
# Prints the agents Omarchy pre-wires as JSON: [{name, label, current}],
# read from the Omarchy menu's "Default Agent" entries so new agents show up
# without a change here.
exec </dev/null

menu="${OMARCHY_PATH:-/usr/share/omarchy}/default/omarchy/omarchy-menu.jsonc"
current=$(omarchy default agent 2>/dev/null)

grep -oE '"setup\.default\.agent\.[a-z0-9-]+": *\{[^}]*"label": *"[^"]*"' "$menu" 2>/dev/null |
  sed -E 's/^"setup\.default\.agent\.([a-z0-9-]+)".*"label": *"([^"]*)"$/\1\t\2/' |
  while IFS=$'\t' read -r name label; do
    jq -cn --arg name "$name" --arg label "$label" --argjson current "$([[ $name == "$current" ]] && echo true || echo false)" '$ARGS.named'
  done | jq -cs .
